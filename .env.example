DOCAYA_ENV=development
PORT=8787
AUTH_MODE=development
LOCAL_SQLITE_ENABLED=true
DEV_TOKEN_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173
REQUEST_BODY_LIMIT_BYTES=1048576
UPLOAD_MAX_BYTES=104857600
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,xlsx,pptx,jpg,jpeg,png,txt
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,image/jpeg,image/png,text/plain
POSTGRES_URL=
# DATABASE_URL is preferred; POSTGRES_URL remains supported for compatibility.
DATABASE_URL=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_USE_MANAGED_IDENTITY=false
REDIS_URL=
REDIS_TOKEN=
SERVICE_BUS_NAMESPACE=
SERVICE_BUS_TOPIC=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
SHAREPOINT_HOSTNAME=hypermineai.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/DocayaDocLibrary-Dev
SHAREPOINT_DRIVE_NAME=Shared Documents
# Legacy compatibility: SHAREPOINT_SITE_URL + SHAREPOINT_DRIVE_ID remain supported for managed identity deployments.
SHAREPOINT_SITE_URL=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_USE_MANAGED_IDENTITY=false
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
